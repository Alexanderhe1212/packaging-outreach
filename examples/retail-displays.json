      "price_policy": {
        "required": false
      },
      "structures": {
        "stepped": "Stepped countertop presentation",
        "backboard": "Base and vertical branded backboard",
        "rotating": "Rotating countertop stand with plausible bearing assembly"
      },
      "supports": [
        "fitted-cutout",
        "shelf",
        "hook"
      ],
      "accessories": [
        "price-card-holder",
        "removable-header"
      ],
      "material_manifest": null
    }
